# Template untuk environment variables.
# Copy file ini ke .env dan isi dengan nilai yang sebenarnya.

# ── API Keys ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Aplikasi ──────────────────────────────────────────────────────────────────
# URL publik/internal server tempat aplikasi diakses (tanpa trailing slash)
# Contoh lokal   : http://localhost:3000
# Contoh server  : http://10.11.15.223:3000
APP_URL=http://localhost:3000

# ── go2rtc (Streaming Server) ─────────────────────────────────────────────────
# Host dan port go2rtc API — gunakan 127.0.0.1 karena go2rtc jalan di server yang sama
# JANGAN ubah ini ke IP publik/internal; koneksi go2rtc adalah server-to-server
GO2RTC_HOST=127.0.0.1
GO2RTC_PORT=1984
